# Copy to .env (docker compose reads it automatically). Never commit .env.

# Optional: if empty, the agent asks for the key at startup (input hidden).
GROQ_API_KEY=

# Folder that holds your kubeconfig (mounted read-only). Default: $HOME/.kube
# KUBE_DIR=/home/you/.kube

# Match your host user so files written to ./manifest belong to you (Linux: run `id -u` / `id -g`).
# AGENT_UID=1000
# AGENT_GID=1000

# Kubeconfig file name inside KUBE_DIR (default: config)
# KUBECONFIG_NAME=config
